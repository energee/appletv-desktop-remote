{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Apple TV Remote",
  "version": "0.7.1",
  "identifier": "com.electron.atvMacRemote",
  "build": {
    "beforeDevCommand": { "script": "pnpm build:renderer && pnpm build:sidecar", "wait": true },
    "beforeBuildCommand": "pnpm build:renderer && pnpm build:sidecar",
    "frontendDist": "../dist/frontend"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Apple TV Remote",
        "width": 280,
        "height": 420,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "windowEffects": { "effects": ["liquidGlassRegular", "popover"], "radius": 16 },
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA4NzYyRTJDN0E0NUVBOTEKUldTUjZrVjZMQzUyQ0tBT0RTc3drYVBiTFZJZUhLeGpteFlQaldmY1NFNlI5cXZ6aFYyazR4YisK",
      "endpoints": [
        "https://github.com/energee/appletv-desktop-remote/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "category": "Utility",
    "copyright": "Copyright © 2026 Ted Slesinski",
    "shortDescription": "Apple TV Remote",
    "longDescription": "Control Apple TV devices from your desktop.",
    "resources": {
      "../dist/desktop-backend/": "sidecar/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.5",
      "signingIdentity": "-",
      "files": { "Resources/Assets.car": "icons/Assets.car" },
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist"
    }
  }
}
