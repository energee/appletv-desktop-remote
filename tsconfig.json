{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "rootDir": "src",
    "resolveJsonModule": true,
    // The library is installed in app/ (it ships inside the sidecar), so tsc can't find it from
    // src/. nodenext needs the .d.ts file itself; the package directory gives TS2307.
    "paths": {
      "node-appletv-remote": ["./app/node_modules/node-appletv-remote/dist/index.d.ts"],
      "node-appletv-remote/*": ["./app/node_modules/node-appletv-remote/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
